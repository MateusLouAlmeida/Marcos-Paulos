classDiagram
    SpecterIA <|-- WardenSpecter
    SpecterIA <|-- AssassinSpecter
    SpecterIA *-- MemoriaDeCombate
    class SpecterIA {
        <<abstract>>
        -int energia
        -MemoriaDeCombate memoria
        +executarTurno()*
        +receberDano(int valor)
        +estaAtivo() Boolean
        +registrar(String log)
    }
    class WardenSpecter {
        +executarTurno()
    }
    class AssassinSpecter {
        +executarTurno()
    }
    class MemoriaDeCombate {
        -List~String~ logs
        +registrarMemoria(String memoria)
    }
